# ----------------------------------------------------------------------
# | Bezpieczna konfiguracja SPA (React/Vite)                           |
# ----------------------------------------------------------------------

# Wyłączamy listowanie katalogów (bezpieczeństwo)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Ustawienie strony startowej
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Jeśli żądanie dotyczy istniejącego pliku lub katalogu, nie rób nic (serwuj go)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Blokada dostępu do wrażliwych plików konfiguracyjnych i katalogów API
    RewriteRule ^(config\.php|composer\.json|package\.json|README\.md|\.env|\.git) - [F,L]
    RewriteRule ^api/(logs|includes|templates|PHPMailer)/ - [F,L]

    # 3. Jeśli żądanie dotyczy API, a plik nie istnieje (punkt 1 nie zadziałał), zwróć 404
    #    Zapobiega to zwracaniu index.html dla błędnych zapytań API
    RewriteRule ^api/ - [L,R=404]

    # 4. Routing SPA: Wszystkie inne żądania kieruj do index.html
    RewriteRule ^index\.html$ - [L]
    RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# | Nagłówki i Cache (Opcjonalne - odkomentuj jeśli serwer pozwala)    |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|xml|gz|html)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# MIME Types (Dla pewności, że JS/CSS są poprawnie interpretowane)
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType text/css .css
</IfModule>
