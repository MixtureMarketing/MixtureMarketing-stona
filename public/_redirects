# Cloudflare Pages _redirects
#
# Kolejnosc matcha (pierwsza pasujaca regula wygrywa):
#  1) Konkretne prefixy z dynamic content -> serwuj /index.html z 200
#     (React Router obsluzy routing po stronie klienta, dla nowych slugow
#     Sanity ktore jeszcze nie sa prerendered).
#  2) Catch-all -> serwuj /404.html z 404 (prerendered NotFound z noindex).
#
# Fizyczne pliki istniejace w dist/ (prerendered routes) sa serwowane
# bezposrednio z 200, _redirects NIE jest dla nich wykonywany.

# URL restructuring 301 (GSC 2026-05-25 — Google matchuje "agencja seo rzeszow"
# na / zamiast na zakopanej /marketing/seo/rzeszow/. Top-level URL lepiej
# matchuje fraze + spojny pattern z /agencja-interaktywna-rzeszow/).
/marketing/seo/rzeszow      /agencja-seo-rzeszow/      301
/marketing/seo/rzeszow/     /agencja-seo-rzeszow/      301

# 301 wariantow frazy "pozycjonowanie stron rzeszow" (16 imp/tyg pos 73 + 8 imp pos 76)
# na /pozycjonowanie-rzeszow/ — jedna strona obsluguje wszystkie warianty.
/pozycjonowanie-stron-rzeszow         /pozycjonowanie-rzeszow/  301
/pozycjonowanie-stron-rzeszow/        /pozycjonowanie-rzeszow/  301
/pozycjonowanie-stron-www-rzeszow     /pozycjonowanie-rzeszow/  301
/pozycjonowanie-stron-www-rzeszow/    /pozycjonowanie-rzeszow/  301
/pozycjonowanie-stron-internetowych-rzeszow   /pozycjonowanie-rzeszow/  301
/pozycjonowanie-stron-internetowych-rzeszow/  /pozycjonowanie-rzeszow/  301

# Trailing-slash 301 redirects (Quick Win #1 z GSC audit 2026-05-21):
# Google indeksowal OBA warianty (/baza-wiedzy/foo + /baza-wiedzy/foo/) jako osobne
# strony, rozdzielajac PageRank. Canonical = wersja z trailing slash (matchuje
# strukture sitemap i prerendera).
# Cloudflare _redirects matchuje placeholder :slug greedy w obrebie jednego segmentu.
/baza-wiedzy/:slug      /baza-wiedzy/:slug/      301
/branza/:slug           /branza/:slug/           301
/miasto/:slug           /miasto/:slug/           301
/portfolio/:slug        /portfolio/:slug/        301
/web-development/:slug  /web-development/:slug/  301
/marketing/:slug        /marketing/:slug/        301
/design/:slug           /design/:slug/           301
/abonament/:slug        /abonament/:slug/        301

# SPA fallback dla naszych dynamicznych prefiksow (Sanity-generated content):
/baza-wiedzy/*      /index.html  200
/branza/*           /index.html  200
/miasto/*           /index.html  200
/portfolio/*        /index.html  200
/web-development/*  /index.html  200
/marketing/*        /index.html  200
/design/*           /index.html  200
/abonament/*        /index.html  200
# (sub-routes professional/vs-wix/vs-orange-klikai prerendered, ale safety net SPA)

# SPA fallback dla panelu (/portal/* NIE jest prerendered — blokada robots.txt).
# Bez tego deep-linki panelu (np. /portal/admin?tab=wyceny) po hard-refreshu trafialyby
# w catch-all 404. Panel jest za auth i noindex, wiec serwowanie index.html jest bezpieczne.
/portal/*  /  200

# Catch-all: nieznane URL-e -> 404 + /404.html (NotFound z noindex).
# Google widzi 404 status, uzytkownik widzi friendly NotFound page.
/*  /404.html  404
