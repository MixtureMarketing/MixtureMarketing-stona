{
  // Typecheck Cloudflare Pages Functions (runtime Workers, nie DOM/Node).
  // Uruchamiany w CI: `npx tsc --noEmit -p functions/tsconfig.json`.
  // MIX-1495: modul wycen publicznych (api/estimation) jest sprawdzany jak reszta funkcji;
  // poza listą zostaje tylko api/admin/estimation (osobny proces pracy). Pliki importowane z
  // niego przez inne funkcje (np. _rateLimit.ts) i tak sprawdza TS jako zależności.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts", "api/admin/estimation/**"]
}
