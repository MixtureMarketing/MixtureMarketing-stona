diff --git a/index.css b/index.css
index 74bdaea..f0684f5 100644
--- a/index.css
+++ b/index.css
@@ -644,3 +644,225 @@ body[data-timeline-cookie='true'] .cookie-floating-btn {
   visibility: hidden;
   pointer-events: none;
 }
+
+/* MIX-1317 K1 „Oś procesu” (components/common/ProcessTimeline.tsx, przełącznik
+   VITE_MM_PROCESS_TIMELINE). Sam CSS, JS 0. Telefon: oś pionowa jak w prototypie
+   (proto1317/k1.html). Komputer: kroki w jednym rzędzie na całą szerokość kontenera, oś
+   pozioma nad nimi (≥ 1024 px; przy 5+ krokach, klasa --dlugi, ≥ 1280 px).
+   Stan spoczynkowy = pełna widoczność: animacje tylko przy wsparciu animation-timeline
+   i bez „ogranicz ruch”; fill both trzyma opacity 1 po przewinięciu. Animowane transform
+   i opacity (plus tło numeru), więc bez przesunięć układu (CLS). */
+@layer components {
+  .mm-k1 {
+    position: relative;
+  }
+  .mm-k1::before,
+  .mm-k1-linia {
+    content: '';
+    position: absolute;
+    left: calc(1.25rem - 1px);
+    top: 1.25rem;
+    bottom: 1.25rem;
+    width: 2px;
+    border-radius: 2px;
+  }
+  .mm-k1::before {
+    background: #e5e7eb;
+  }
+  .mm-k1-linia {
+    background: linear-gradient(var(--color-primary), var(--color-secondary));
+    transform-origin: top;
+  }
+  .mm-k1-kroki {
+    position: relative;
+    z-index: 1;
+    display: grid;
+    gap: 1.5rem;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+  }
+  .mm-k1-krok {
+    display: grid;
+    grid-template-columns: 2.5rem minmax(0, 1fr);
+    gap: 1rem;
+    align-items: start;
+  }
+  .mm-k1-nr {
+    display: grid;
+    place-items: center;
+    width: 2.5rem;
+    height: 2.5rem;
+    border: 2px solid var(--color-secondary);
+    border-radius: 9999px;
+    background: #fff;
+    color: var(--color-secondary);
+    font-size: 0.875rem;
+    font-weight: 800;
+    font-variant-numeric: tabular-nums;
+  }
+}
+
+/* Komputer: rząd kroków + oś pozioma od środka pierwszego do środka ostatniego numeru. */
+@media (min-width: 1024px) {
+  .mm-k1:not(.mm-k1--dlugi)::before,
+  .mm-k1:not(.mm-k1--dlugi) .mm-k1-linia {
+    top: calc(1.25rem - 1px);
+    bottom: auto;
+    left: 1.25rem;
+    right: calc((100% - (var(--k1-n) - 1) * 2rem) / var(--k1-n) - 1.25rem);
+    width: auto;
+    height: 2px;
+  }
+  .mm-k1:not(.mm-k1--dlugi) .mm-k1-linia {
+    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
+    transform-origin: left;
+  }
+  .mm-k1:not(.mm-k1--dlugi) .mm-k1-kroki {
+    grid-template-columns: repeat(var(--k1-n), minmax(0, 1fr));
+    gap: 2rem;
+  }
+  .mm-k1:not(.mm-k1--dlugi) .mm-k1-krok {
+    display: block;
+  }
+  .mm-k1:not(.mm-k1--dlugi) .mm-k1-tresc {
+    margin-top: 1.25rem;
+  }
+}
+@media (min-width: 1280px) {
+  .mm-k1::before,
+  .mm-k1 .mm-k1-linia {
+    top: calc(1.25rem - 1px);
+    bottom: auto;
+    left: 1.25rem;
+    right: calc((100% - (var(--k1-n) - 1) * 2rem) / var(--k1-n) - 1.25rem);
+    width: auto;
+    height: 2px;
+  }
+  .mm-k1 .mm-k1-linia {
+    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
+    transform-origin: left;
+  }
+  .mm-k1 .mm-k1-kroki {
+    grid-template-columns: repeat(var(--k1-n), minmax(0, 1fr));
+    gap: 2rem;
+  }
+  .mm-k1 .mm-k1-krok {
+    display: block;
+  }
+  .mm-k1 .mm-k1-tresc {
+    margin-top: 1.25rem;
+  }
+}
+
+@supports (animation-timeline: view()) {
+  @media (prefers-reduced-motion: no-preference) {
+    .mm-k1 {
