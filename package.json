{
  "name": "mixture-marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "mcp:sanity": "cross-env MCP_USER_ROLE=developer npx -y @sanity/mcp-server@latest --projectId azuef2ua --dataset production",
    "images": "node scripts/convert-images.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run images",
    "build": "vite build && npm run sitemap && npm run prerender && npx size-limit",
    "build:full": "npm run lint && vitest run && npm run build && npm run audit:health",
    "prerender": "node prerender.js",
    "audit:a11y": "node scripts/audit-a11y.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:health": "node scripts/audit-health.js",
    "audit:perf": "node scripts/audit-performance.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "node scripts/test-e2e-contact.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "300 kB"
    },
    {
      "path": "dist/assets/index-*.css",
      "limit": "50 kB"
    }
  ],
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@portabletext/react": "^7.0.1",
    "@portabletext/types": "^4.0.1",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "beasties": "^0.4.3",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.0.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.84.0",
    "react-is": "^19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "web-vitals": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-app": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "puppeteer": "^25.4.0",
    "react-scan": "^0.5.7",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "size-limit": "^13.0.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-svgo": "^3.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {}
}
