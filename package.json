{
  "name": "mixture-marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "mcp:sanity": "cross-env MCP_USER_ROLE=developer npx -y @sanity/mcp-server@latest --projectId azuef2ua --dataset production",
    "images": "node scripts/convert-images.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run images && vite build && npm run sitemap && npm run prerender && npm run audit:health",
    "prerender": "node prerender.js",
    "audit:a11y": "node scripts/audit-a11y.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:health": "node scripts/audit-health.js",
    "audit:perf": "node scripts/audit-performance.js",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/assets/vendor-react-*.js",
      "limit": "60 kB"
    },
    {
      "path": "dist/assets/vendor-icons-*.js",
      "limit": "20 kB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "40 kB"
    }
  ],
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@google/genai": "^1.31.0",
    "@portabletext/react": "^6.0.2",
    "@sanity/client": "^7.14.0",
    "@sanity/image-url": "^2.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "framer-motion": "^12.29.0",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.69.0",
    "react-router-dom": "6.22.3",
    "recharts": "2.15.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@size-limit/preset-app": "^12.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@unlighthouse/vite": "^0.10.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.11.0",
    "critters": "^0.0.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "puppeteer": "^24.34.0",
    "react-scan": "^0.4.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "size-limit": "^12.0.0",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.0.16",
    "why-did-you-render": "^1.0.1"
  }
}
