{
  "name": "mixture-marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "mcp:sanity": "cross-env MCP_USER_ROLE=developer npx -y @sanity/mcp-server@latest --projectId azuef2ua --dataset production",
    "images": "node scripts/convert-images.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run images",
    "build": "vite build && npm run sitemap && npm run prerender && npx size-limit",
    "build:full": "npm run lint && vitest run && npm run build && npm run audit:health",
    "prerender": "node prerender.js",
    "audit:a11y": "node scripts/audit-a11y.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:health": "node scripts/audit-health.js",
    "audit:perf": "node scripts/audit-performance.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "node scripts/test-e2e-contact.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "300 kB"
    },
    {
      "path": "dist/assets/index-*.css",
      "limit": "50 kB"
    }
  ],
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.5.2",
    "@portabletext/react": "^6.0.2",
    "@portabletext/types": "^4.0.1",
    "@sanity/client": "^7.14.1",
    "@sanity/image-url": "^2.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "beasties": "^0.4.1",
    "framer-motion": "^12.29.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.71.1",
    "react-is": "^19.2.4",
    "react-router-dom": "7.13.0",
    "recharts": "3.7.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@size-limit/preset-app": "^12.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "puppeteer": "^24.36.1",
    "react-scan": "^0.4.3",
    "rimraf": "^6.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "size-limit": "^12.0.0",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-svgo": "^2.0.0",
    "vitest": "^4.0.18"
  },
  "overrides": {}
}
