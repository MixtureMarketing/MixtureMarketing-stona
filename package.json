{
  "name": "mixture-marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "mcp:sanity": "cross-env MCP_USER_ROLE=developer npx -y @sanity/mcp-server@0.12.2 --projectId azuef2ua --dataset production",
    "images": "node scripts/convert-images.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run images",
    "build": "vite build && npm run sitemap && npm run prerender && npx size-limit",
    "build:full": "npm run lint && vitest run && npm run build && npm run audit:health",
    "prerender": "node prerender.js",
    "audit:a11y": "node scripts/audit-a11y.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:health": "node scripts/audit-health.js",
    "audit:perf": "node scripts/audit-performance.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "node scripts/test-e2e-contact.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "300 kB"
    },
    {
      "path": "dist/assets/index-*.css",
      "limit": "50 kB"
    }
  ],
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "beasties": "^0.5.5",
    "dompurify": "^3.4.17",
    "framer-motion": "^13.5.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.2",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "react-scan": "^0.5.7",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.35.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {}
}
