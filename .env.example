VITE_MM_PREONBOARD_KEY=
VITE_MM_HUB_URL=https://api.mixturemarketing.pl
# Stripe publishable key (pk_test_xxx dla testów, pk_live_xxx na produkcji)
VITE_STRIPE_PUBLISHABLE_KEY=
