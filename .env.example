VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-21

# SaaS "Strona w abonamencie" — keys do landing /abonament/
# Scoped: POST /api/admin/preonboard + POST /api/admin/stripe/checkout
