{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "prerender.js",
    "routes.js",
    "vite.config.ts",
    "vite-env.d.ts",
    "components/**/*",
    "config/**/*",
    "context/**/*",
    "data/**/*",
    "hooks/**/*",
    "services/**/*",
    "tests/**/*",
    "types/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist", ".vite", "studio-mixture-marketing"]
}
